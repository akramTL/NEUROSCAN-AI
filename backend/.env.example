# ──────────────────────────────────────────────
#  NeuroScan AI – environment variable template
#  Copy to .env and fill in real values.
#  Never commit .env to version control.
# ──────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://neuroscan:changeme@localhost:5432/neuroscan_db

# Secret key used for signing JWT tokens (generate with: openssl rand -hex 32)
SECRET_KEY=replace-with-a-random-secret-key

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Absolute or relative path where uploaded files are stored
UPLOAD_DIR=./uploads

# Maximum allowed upload size in megabytes
MAX_FILE_SIZE_MB=50

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# AI model backend: 'stub' (default) or 'local'
MODEL_BACKEND=stub
MODEL_PATH=./model/model.pkl
