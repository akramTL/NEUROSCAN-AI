SECRET_KEY=generate-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=100
ALLOWED_ORIGINS=["https://your-vercel-url.vercel.app"]
